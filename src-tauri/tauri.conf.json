{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Photo Editor",
  "version": "0.2.2",
  "identifier": "com.phototexteditor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Photo Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["png"],
        "name": "PNG Image",
        "description": "Portable Network Graphics",
        "mimeType": "image/png",
        "role": "Editor"
      },
      {
        "ext": ["jpg", "jpeg"],
        "name": "JPEG Image",
        "description": "Joint Photographic Experts Group",
        "mimeType": "image/jpeg",
        "role": "Editor"
      },
      {
        "ext": ["webp"],
        "name": "WebP Image",
        "description": "WebP Image",
        "mimeType": "image/webp",
        "role": "Editor"
      }
    ]
  }
}
